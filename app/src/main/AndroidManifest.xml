<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".PromptEditorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PromptEditor">
        <activity
            android:name=".feature.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PromptEditor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".feature.presetset.PresetSetEditActivity"
            android:exported="false"
            android:theme="@style/Theme.PromptEditor" />
        <activity
            android:name=".feature.preset.PresetEditActivity"
            android:exported="false"
            android:theme="@style/Theme.PromptEditor" />
        <activity
            android:name=".feature.tagsedit.TagsEditActivity"
            android:exported="false"
            android:theme="@style/Theme.PromptEditor" />
        <activity
            android:name=".feature.tagssearch.TagsSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.PromptEditor" />
    </application>

</manifest>